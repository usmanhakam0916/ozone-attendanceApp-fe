{
  "name": "ant-design-pro",
  "version": "4.5.0",
  "private": true,
  "description": "An out-of-box UI solution for enterprise applications",
  "scripts": {
    "analyze": "cross-env ANALYZE=1 umi build",
    "build": "umi build",
    "deploy": "npm run site && npm run gh-pages",
    "dev": "npm run start:dev",
    "start": "node server.js",
    "fetch:blocks": "pro fetch-blocks && npm run prettier",
    "gh-pages": "gh-pages -d dist",
    "postinstall": "umi g tmp",
    "lint": "umi g tmp && npm run lint:js && npm run lint:style && npm run lint:prettier",
    "lint-staged:js": "eslint --ext .js,.jsx,.ts,.tsx ",
    "lint:fix": "eslint --fix --cache --ext .js,.jsx,.ts,.tsx --format=pretty ./src && npm run lint:style",
    "lint:js": "eslint --cache --ext .js,.jsx,.ts,.tsx --format=pretty ./src",
    "lint:prettier": "prettier --check \"src/**/*\" --end-of-line auto",
    "lint:style": "stylelint --fix \"src/**/*.less\" --syntax less",
    "precommit": "lint-staged",
    "prettier": "prettier -c --write \"src/**/*\"",
    "start:dev": "cross-env REACT_APP_ENV=dev MOCK=none UMI_ENV=dev umi dev",
    "start:no-mock": "cross-env MOCK=none UMI_ENV=dev umi dev",
    "start:no-ui": "cross-env UMI_UI=none UMI_ENV=dev umi dev",
    "start:pre": "cross-env REACT_APP_ENV=pre UMI_ENV=dev umi dev",
    "start:test": "cross-env REACT_APP_ENV=test MOCK=none UMI_ENV=dev umi dev",
    "pretest": "node ./tests/beforeTest",
    "test": "umi test",
    "test:all": "node ./tests/run-tests.js",
    "test:component": "umi test ./src/components",
    "tsc": "tsc --noEmit"
  },
  "lint-staged": {
    "**/*.less": "stylelint --syntax less",
    "**/*.{js,jsx,ts,tsx}": "npm run lint-staged:js",
    "**/*.{js,jsx,tsx,ts,less,md,json}": [
      "prettier --write"
    ]
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 10"
  ],
  "dependencies": {
    "@ant-design/icons": "^4.7.0",
    "@ant-design/pro-descriptions": "^1.10.10",
    "@ant-design/pro-form": "^1.69.0",
    "@ant-design/pro-layout": "^6.34.1",
    "@ant-design/pro-table": "3.21.0",
    "@react-google-maps/api": "^2.20.7",
    "@umijs/route-utils": "^4.0.3",
    "antd": "^4.24.15",
    "array-move": "^3.0.1",
    "chart.js": "^3.9.1",
    "classnames": "^2.3.2",
    "js-export-excel": "^1.1.4",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "numeral": "^2.0.6",
    "omit.js": "^2.0.2",
    "qrcode.react": "^1.0.1",
    "qs": "^6.11.2",
    "react": "^17.0.2",
    "react-chartjs-2": "^3.0.4",
    "react-dev-inspector": "^1.3.0",
    "react-dom": "^17.0.2",
    "react-helmet-async": "^1.3.0",
    "react-player": "^2.10.1",
    "react-video-thumbnail": "^0.1.3",
    "react-webcam": "^7.0.1",
    "umi": "^3.5.35",
    "umi-request": "^1.3.9"
  },
  "devDependencies": {
    "@ant-design/pro-cli": "^3.3.0",
    "@types/classnames": "^2.3.1",
    "@types/express": "^4.17.17",
    "@types/history": "^4.7.11",
    "@types/jest": "^26.0.24",
    "@types/lodash": "^4.14.191",
    "@types/qs": "^6.9.7",
    "@types/react": "^17.0.52",
    "@types/react-dom": "^17.0.18",
    "@types/react-helmet": "^6.1.6",
    "@umijs/fabric": "^2.9.8",
    "@umijs/plugin-blocks": "^2.0.3",
    "@umijs/plugin-esbuild": "^1.1.3",
    "@umijs/preset-ant-design-pro": "^1.2.3",
    "@umijs/preset-react": "^1.8.18",
    "@umijs/yorkie": "^2.0.5",
    "carlo": "^0.9.46",
    "chalk": "^4.1.2",
    "compression": "^1.7.4",
    "cross-env": "^7.0.3",
    "cross-port-killer": "^1.2.1",
    "detect-installer": "^1.0.1",
    "enzyme": "^3.11.0",
    "eslint": "^7.32.0",
    "express": "^4.18.2",
    "gh-pages": "^3.2.3",
    "jsdom-global": "^3.0.2",
    "lint-staged": "^10.5.4",
    "mockjs": "^1.1.0",
    "prettier": "^2.8.8",
    "puppeteer-core": "^7.1.0",
    "stylelint": "^13.13.1",
    "typescript": "^4.9.5"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "checkFiles": [
    "src/**/*.js*",
    "src/**/*.ts*",
    "src/**/*.less",
    "config/**/*.js*",
    "scripts/**/*.js"
  ]
}
